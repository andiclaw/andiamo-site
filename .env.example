# Postmark server token for the /report intake.
# Without it, dev mode logs submissions and returns { ok: true, dev: true }.
# Production refuses to send and returns 503.
POSTMARK_SERVER_TOKEN=

# Override the destination for /report submissions (default: support@andiamo.tech)
SUPPORT_TO_EMAIL=

# Override the From: address (default: noreply@andiamo.tech)
# Must be a domain verified in Postmark.
SUPPORT_FROM_EMAIL=
